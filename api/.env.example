# Copy this file to .env and fill in the values before running docker-compose.prod.yml.
# .env is gitignored — never commit the real values.

# Google OAuth2 client ID — same value as VITE_GOOGLE_CLIENT_ID in the frontend
GOOGLE_OAUTH2_CLIENT_ID=

# API-Football key from rapidapi.com
FOOTBALL_API_KEY=

# Optional: override MongoDB credentials (defaults shown)
# MONGO_USER=root
# MONGO_PASSWORD=wc-dreamix

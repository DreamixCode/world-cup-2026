# Copy to .env.local for local overrides (gitignored).
# .env.production is committed and used automatically by `npm run build`.

# Google OAuth2 client ID — must match GOOGLE_OAUTH2_CLIENT_ID on the backend
VITE_GOOGLE_CLIENT_ID=

# Base URL of the backend API, including the /api prefix.
# Leave empty to use the same-origin /api proxy (dev server only).
VITE_API_URL=
